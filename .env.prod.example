# Production environment for docker-compose.prod.yml.
# Copy to `.env.prod` and fill in real values — never commit `.env.prod`.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod config   # validate
#
# Generate an application key with:
#   docker run --rm -v "$PWD/backend:/app" -w /app php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Mob Limited"
APP_KEY=base64:CHANGE_ME_32_BYTE_KEY
APP_VERSION=1.0.0

# Public URLs (must match the domains your TLS proxy serves).
# APP_URL is the backend API origin; FRONTEND_URL/NEXT_PUBLIC_SITE_URL the site.
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Shared secret for Next.js ISR cache revalidation (must match backend + frontend).
REVALIDATE_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Sanctum token lifetime in minutes (default 7 days).
SANCTUM_EXPIRATION=10080

# Comma-separated origins allowed by CORS / Sanctum stateful checks.
CORS_ALLOWED_ORIGINS=https://www.example.com,https://api.example.com
SANCTUM_STATEFUL_DOMAINS=www.example.com,api.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DATABASE=mining
DB_USERNAME=mining
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---------------------------------------------------------------------------
# First super-admin (seeded on first boot; idempotent). Leave blank to skip.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# Redis (internal; add password if you expose Redis or want defense in depth)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# Mail (required for password-reset emails)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Storage (S3 / R2 / MinIO). Set FILESYSTEM_DISK=s3 in production.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mining-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
SESSION_ENCRYPT=true
DB_SSLMODE=require
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
